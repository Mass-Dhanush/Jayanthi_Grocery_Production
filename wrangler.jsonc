{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jayanthi-grocery-production",
  "main": "worker.js",
  "compatibility_date": "2026-05-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health", "/admin"]
  },
  "d1_databases": [
    {
      "binding": "jayanthi_grocery_db",
      "database_name": "jayanthi-grocery-db",
      "database_id": "e9f8afbf-16d8-40aa-9c73-25d002754cbd"
    }
  ]
}
